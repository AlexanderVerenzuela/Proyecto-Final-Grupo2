<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Barra de Título Superior -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarCursos"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="Selección de Curso"
        app:titleTextColor="@color/white" />

    <!-- Barra de Búsqueda de Cursos -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBuscarCurso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@color/card_bg"
        app:cardCornerRadius="8dp"
        app:cardElevation="1dp"
        app:strokeColor="@color/border_dark"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarCursos">

        <EditText
            android:id="@+id/etBuscarCurso"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@null"
            android:hint="Buscar curso por nombre o código..."
            android:paddingHorizontal="14dp"
            android:textColor="@color/white"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Indicador de Carga -->
    <ProgressBar
        android:id="@+id/progressBarCursos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardBuscarCurso" />

    <!-- Mensaje de Lista Vacía -->
    <TextView
        android:id="@+id/tvCursosVacios"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No se encontraron cursos disponibles."
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardBuscarCurso" />

    <!-- RecyclerView de Cursos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCursos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardBuscarCurso"
        tools:listitem="@layout/item_curso" />

</androidx.constraintlayout.widget.ConstraintLayout>
