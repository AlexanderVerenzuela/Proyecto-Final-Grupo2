<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarTomarAsistencia"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="Registro de Asistencia"
        app:titleTextColor="@color/white" />

    <!-- Tarjeta con Datos del Curso y Selector de Fecha -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardInfoSesion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@color/card_bg"
        app:cardCornerRadius="10dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/border_dark"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarTomarAsistencia">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvCursoTitulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Desarrollo de Aplicaciones Móviles I [DAM-501]" />

            <TextView
                android:id="@+id/tvCursoDocente"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvCursoTitulo"
                tools:text="Docente: Mg. Carlos Mendoza • Sec. T5BN" />

            <!-- Selector de Fecha de la Sesión -->
            <LinearLayout
                android:id="@+id/layoutFecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_badge_course"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvCursoDocente">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📅 Fecha: "
                    android:textColor="@color/accent"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvFechaSeleccionada"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="2026-10-14" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTemporizadorSesion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Sesión: sin seleccionar"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layoutFecha"
                tools:text="Sesión: Clase | Tiempo restante: 02:59:45" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCerrarSesion"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:text="Cerrar sesión"
                android:textColor="@color/white"
                android:backgroundTint="@color/primary"
                android:visibility="gone"
                app:cornerRadius="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTemporizadorSesion" />



            <!-- Botón para mostrar resumen de asistencia -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResumen"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:text="Ver resumen"
                android:textSize="12sp"
                android:textColor="@color/white"
                app:cornerRadius="12dp"
                app:strokeColor="@color/accent"
                app:icon="@android:drawable/ic_menu_info_details"
                app:iconTint="@color/accent"
                app:iconPadding="6dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTemporizadorSesion" />


            <!-- Botón Rápido: Marcar Todos Presentes -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMarcarTodosPresentes"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:paddingHorizontal="12dp"
                android:text="Todos Presentes"
                android:textColor="@color/white"
                android:textSize="11sp"
                app:strokeColor="@color/border_dark"
                app:layout_constraintBottom_toBottomOf="@id/layoutFecha"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/layoutFecha" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Indicador de Carga -->
    <ProgressBar
        android:id="@+id/progressBarTomar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomBarLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardInfoSesion" />

    <!-- Mensaje si no hay alumnos -->
    <TextView
        android:id="@+id/tvAlumnosVacios"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No se encontraron alumnos para este curso."
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomBarLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardInfoSesion" />

    <!-- Lista RecyclerView de Alumnos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAlumnosAsistencia"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBarLayout"
        app:layout_constraintTop_toBottomOf="@id/cardInfoSesion"
        tools:listitem="@layout/item_alumno_asistencia" />

    <!-- Barra Inferior de Acción: Guardar Asistencia -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_bg"
        android:elevation="8dp"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarAsistencia"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="@color/primary"
            android:text="Guardar Asistencias en SQLite"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
