<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Estado de Asistencia:"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgDialogEstado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbDialogPresente"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="@color/color_presente"
            android:text="Presente"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/rbDialogTardanza"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="@color/color_tardanza"
            android:text="Tardanza"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/rbDialogAusente"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="@color/color_ausente"
            android:text="Ausente"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />
    </RadioGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Observación:"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etDialogObs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_badge_course"
        android:hint="Ingrese motivo, justificación o notas..."
        android:padding="12dp"
        android:textColor="@color/white"
        android:textColorHint="@color/text_muted"
        android:textSize="13sp" />

</LinearLayout>
